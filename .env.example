# Redis Configuration
REDIS_PASSWORD=your_redis_password_here

# MQTT Configuration (optional, used when mqtt profile is active)
MQTT_BROKER=homeassistant.local
MQTT_PORT=1883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=mqtt_password

# Home Assistant API Configuration (optional, for direct HA integration)
HA_ENABLED=false
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token_here
HA_WEBSOCKET=true

# Logging
LOG_LEVEL=info
